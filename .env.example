# ---- 上游域名(逗号分隔多个, 按顺序 failover; 域名经常换, 换域时只改这里) ----
# 优先 dahua309.uk; 失败的域名会自动熔断(冷却期内跳过), 冷却后自动恢复
CHALAOSHI_WEB_BASE=https://dahua309.uk,https://chalaoshi.de
CHALAOSHI_API_BASE=https://api.dahua309.uk,https://api.chalaoshi.de

# 全站同类服务兜底: 上面主域名全部失败(被拦/超时/5xx)后, 再试这里的镜像站。
# 逗号分隔; 留空不启用。兜底站须与上游返回同样结构的 HTML/JSON(同一 path)。
CHALAOSHI_FALLBACK=

# 单个请求超时(毫秒); 接受 3000~120000 的整数。上游实测 3~7s(搜索页最慢), 设 8s 给它留余量。
# 太短(如 1s)会导致每次都超时, 并把域名熔断掉, 整站 502。
CHALAOSHI_TIMEOUT_MS=8000

# 域名熔断冷却(毫秒): 某域名失败后跳过它多久, 再允许重试
FAILOVER_COOLDOWN_MS=60000

# ---- 缓存 TTL(秒) ----
CACHE_TTL_SEARCH=60
CACHE_TTL_TEACHER=300
CACHE_TTL_COMMENTS=60
CACHE_TTL_GPA=1800

# 每 IP 每分钟 API 请求上限(接受 0~1000 的整数, 0 表示不限流)
RATE_LIMIT_PER_MIN=60
