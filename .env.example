# ---- 上游域名(逗号分隔多个, 按顺序 failover; 域名经常换, 换域时只改这里) ----
CHALAOSHI_WEB_BASE=https://chalaoshi.de
CHALAOSHI_API_BASE=https://api.chalaoshi.de

# 单个请求超时(毫秒)
CHALAOSHI_TIMEOUT_MS=20000

# ---- 缓存 TTL(秒) ----
CACHE_TTL_SEARCH=60
CACHE_TTL_TEACHER=300
CACHE_TTL_COMMENTS=60
CACHE_TTL_GPA=1800

# 每 IP 每分钟 API 请求上限(0 表示不限流)
RATE_LIMIT_PER_MIN=60
